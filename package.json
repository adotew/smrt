{
  "name": "smrt",
  "productName": "Smrt",
  "version": "1.0.0",
  "private": true,
  "description": "A small PDF library and reader with per-page notes.",
  "main": "build/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.ts",
    "test": "node --test",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "node scripts/electron.ts && vite build",
    "package": "npm run build && electron-packager . Smrt --out=release --overwrite --icon=assets/Smrt --ignore=\"^/(assets|src|electron|scripts|release|vite\\.config\\.ts|tsconfig\\.json|index\\.html)\"",
    "dmg": "npm run package -- --arch=arm64 --osx-sign && node scripts/dmg.ts"
  },
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "bits-ui": "^2.20.6",
    "cn": "^0.5.2",
    "electron": "^45.2.2",
    "esbuild": "^0.28.2",
    "shadcn-svelte": "^1.8.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-bubble-menu": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438"
  }
}
