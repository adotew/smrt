{
  "name": "smrt",
  "productName": "Smrt",
  "version": "1.0.0",
  "private": true,
  "description": "A small PDF library and reader with per-page notes.",
  "main": "build/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.ts",
    "test": "node --test",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "node scripts/electron.ts && vite build",
    "package": "npm run build && electron-packager . Smrt --out=release --overwrite --ignore=\"^/(src|electron|scripts|release|vite\\.config\\.ts|tsconfig\\.json|index\\.html)\""
  },
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "electron": "^45.2.2",
    "esbuild": "^0.28.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438"
  }
}
