{
  "name": "smrt",
  "productName": "Smrt",
  "version": "1.0.3",
  "private": true,
  "description": "A small PDF library and reader with per-page notes.",
  "main": "build/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.ts",
    "seed": "node scripts/seed.ts",
    "test": "node --test",
    "check": "tsc -p .",
    "build": "node scripts/electron.ts && vite build",
    "package": "npm run build && electron-packager . Smrt --out=release --overwrite --icon=assets/Smrt --ignore=\"^/(?!build($|/)|dist($|/)|node_modules($|/)|package\\.json$)|^/node_modules/\\.vite($|/)\" --asar.unpack=\"**/{.**,**}/**/*.node\" --asar.unpackDir=\"node_modules/@anthropic-ai/claude-agent-sdk-*\"",
    "dmg": "npm run package -- --arch=arm64 --osx-sign && node scripts/dmg.ts"
  },
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "electron": "^45.2.2",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.75.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.180",
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@shadcn/helpers": "^0.3.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-bubble-menu": "^3.32.2",
    "@tiptap/extension-details": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "ai": "^7.0.166",
    "dockview-react": "^8.9.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "streamdown": "^2.8.0"
  }
}
