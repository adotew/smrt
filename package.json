{
  "name": "smrt",
  "productName": "Smrt",
  "version": "1.0.0",
  "private": true,
  "description": "A small PDF library and reader with per-page notes.",
  "main": "main.js",
  "scripts": {
    "start": "vite build && electron .",
    "dev": "node scripts/dev.js",
    "test": "node --test",
    "build": "vite build",
    "package": "vite build && electron-packager . Smrt --out=release --overwrite --ignore=\"^/(src|scripts|release|library\\.test\\.js|vite\\.config\\.js|index\\.html)\""
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "electron": "^45.2.2",
    "svelte": "^5.57.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438"
  }
}
